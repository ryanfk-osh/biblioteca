a na Amazon. Não custa nada a mais, mas uma pequena porcentagem de todas as vendas vai para apoiar este canal !!\n\nEste conteúdo não deve ser copiado ou distribuído sem meu consentimento.","commandRuns":[{"startIndex":672,"length":23,"onTap":{"innertubeCommand":{"clickTrackingParams":"CPwCEM2rARgBIhMI_9zCu7ytlgMVx0rdAh2_Hw4QSL_WqbLzqJeZhwHKAQS0ksPh","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rVFFuXy1oLXlxOWtDT2htNVVsXzVuRXxBR3JiS2FucTlIeVpKek0xekJ6RzlkeXh2T2FNLXZHQ1pMVnI1ZnltWk1HQUEtTm9oMHJMM0htTWpkdmY2ejVMdTRDbHVwUkNHeW55WUNuSUdhTjF2MEFUaG1ZUkpkV3EteERM\u0026q=https%3A%2F%2Famzn.to%2F30Fn2W3\u0026v=hzJdRzZKaz8","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rVFFuXy1oLXlxOWtDT2htNVVsXzVuRXxBR3JiS2FucTlIeVpKek0xekJ6RzlkeXh2T2FNLXZHQ1pMVnI1ZnltWk1HQUEtTm9oMHJMM0htTWpkdmY2ejVMdTRDbHVwUkNHeW55WUNuSUdhTjF2MEFUaG1ZUkpkV3EteERM\u0026q=https%3A%2F%2Famzn.to%2F30Fn2W3\u0026v=hzJdRzZKaz8","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":706,"length":23,"onTap":{"innertubeCommand":{"clickTrackingParams":"CPwCEM2rARgBIhMI_9zCu7ytlgMVx0rdAh2_Hw4QSL_WqbLzqJeZhwHKAQS0ksPh","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rVEMyVUMyaEI5R2tKdFBvaXR0YUtoMHxBR3JiS2FrNHFiQWJnd3BFUmZ6MFd5US1MUjZ3NXlJaTE5VVBMblVraW5YUGZwbFRNQXNnT3VlcVpjc0o3WkthOG1CRlctOFRQQzBCbDhpMEV6UnB0SXY2LUQ1bUtYVzAwdF84\u0026q=https%3A%2F%2Famzn.to%2F38kjoRX\u0026v=hzJdRzZKaz8","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rVEMyVUMyaEI5R2tKdFBvaXR0YUtoMHxBR3JiS2FrNHFiQWJnd3BFUmZ6MFd5US1MUjZ3NXlJaTE5VVBMblVraW5YUGZwbFRNQXNnT3VlcVpjc0o3WkthOG1CRlctOFRQQzBCbDhpMEV6UnB0SXY2LUQ1bUtYVzAwdF84\u0026q=https%3A%2F%2Famzn.to%2F38kj